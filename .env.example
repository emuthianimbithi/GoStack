# Server Configuration
HTTP_ADDR=:8080

# Database Configuration
# Replace with your actual Postgres connection string
DB_DSN="host=localhost user=postgres password=postgres dbname=postgres port=5432 sslmode=disable"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# OpenTelemetry Configuration
# Point to your OTel Collector or SigNoz instance
OTEL_EXPORTER_OTLP_ENDPOINT="localhost:4317"

# Authentication Configuration
AUTH_ACCESS_TOKEN_DURATION="15m"
AUTH_REFRESH_TOKEN_DURATION="168h"
